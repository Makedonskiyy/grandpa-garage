{
  "name": "dedov-garage",
  "private": true,
  "version": "0.2.1",
  "description": "Дедов гараж — браузерная 2D-игра в пиксельной графике (симулятор конструирования). Команда TRITON.",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test && npm run build",
    "pixelize": "node tools/pixelize.mjs",
    "art": "node tools/build-art.mjs",
    "garage-bg": "node tools/build-garage-bg.mjs",
    "car": "node tools/build-car.mjs",
    "characters": "node tools/build-characters.mjs",
    "hud": "node tools/build-hud.mjs",
    "start-light": "py -I tools/build-start-light.py",
    "menu-bg": "node tools/build-menu-bg.mjs",
    "sound-doc": "node tools/build-sound-doc.mjs && prettier --write docs/sound"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
